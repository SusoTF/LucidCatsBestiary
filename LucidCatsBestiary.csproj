<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LucidCatsBestiary</AssemblyName>
    <RootNamespace>LucidCatsBestiary</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>

    <!-- ============================================================ -->
    <!-- Carpeta donde está LucidCats.exe                               -->
    <!-- ============================================================ -->
    <GameDir>D:\SteamLibrary\steamapps\common\Lucid Cats</GameDir>

    <ManagedDir>$(GameDir)\LucidCats_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- References to BepInEx and the game. Private=false: they are NOT copied next to the mod. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.*.dll" Private="false" />
  </ItemGroup>

  <!-- After every build, copy the mod straight into BepInEx\plugins -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\LucidCatsBestiary" />
    <Message Importance="high" Text="Mod copied to $(BepInExDir)\plugins\LucidCatsBestiary" />
  </Target>

</Project>
